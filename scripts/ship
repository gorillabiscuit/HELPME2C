#!/usr/bin/env bash
# scripts/ship HEL-N — push a card's lane and open its pull request. Claude runs this once Wouter
# has said "ship it" for this card (CLAUDE.md §7, ADR-0031); Wouter may run it himself. A card
# worker never does. Then scripts/land merges it once CI passes.
#
#   scripts/ship HEL-13            show what will be pushed, ask, then push and open the PR
#   scripts/ship HEL-13 --yes      the same without asking (Claude, after Wouter's go)
#   scripts/ship HEL-13 --anyway   ship even though the last review reproduced a finding
#   scripts/ship some-branch --yes a branch that is not a card: push it, PR from its commits
#
# It checks that the GitHub CLI is logged in as gorillabiscuit (the repo is personal; the
# Polymodal work login cannot see it), that the lane has commits and nothing uncommitted, and
# what the last independent review said. The push runs the pre-push hook as usual (AI-attribution
# scan, then pnpm preflight). The pull request body is the "## PR description" section of the
# worker's last report; if there is none, a short body that links the card. The card gets a
# comment with the pull request link. Nothing is merged and the card is not moved.
set -euo pipefail

SELF_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
MAIN="$(cd "$(git -C "$SELF_ROOT" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)"
RUNS="$MAIN/.agent-runs"
REPO="gorillabiscuit/HELPME2C"
LINEAR=(python3 -I "$SELF_ROOT/scripts/lib/linear.py")
N24="$HOME/.nvm/versions/node/v24.16.0/bin"
[ -d "$N24" ] && export PATH="$N24:$PATH"
die() { printf 'ship: %s\n' "$*" >&2; exit 1; }

TARGET="${1:-}"
[ -n "$TARGET" ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
ID="$(printf '%s' "$TARGET" | tr '[:lower:]' '[:upper:]')"
shift
GO=0; ANYWAY=0
for arg in "$@"; do
  case "$arg" in --yes) GO=1 ;; --anyway) ANYWAY=1 ;; *) die "unknown option: $arg" ;; esac
done
if [ -n "${CODEX_SANDBOX:-}" ] || [ -n "${CODEX_SANDBOX_NETWORK_DISABLED:-}" ]; then
  die "a card worker never pushes (.claude/skills/worker/SKILL.md); Claude ships on Wouter's go."
fi

# A branch that is not a card (docs, CI, tooling): push it and open a pull request whose title
# and body come from its commits. The pre-push hook still runs the attribution scan and preflight.
case "$ID" in HEL-[0-9]*) ;; *)
  BRANCH="$TARGET"
  git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BRANCH" || die "no local branch $BRANCH"
  who="$(env -u GH_CONFIG_DIR gh api user --jq .login 2>/dev/null || true)"
  [ "$who" = gorillabiscuit ] || die "the GitHub CLI is logged in as '${who:-nobody}', not gorillabiscuit."
  git -C "$MAIN" fetch -q origin main
  AHEAD="$(git -C "$MAIN" rev-list --count "origin/main..$BRANCH")"
  [ "$AHEAD" -gt 0 ] || die "$BRANCH has no commits that are not on main."
  echo "About to ship branch $BRANCH ($AHEAD commit(s) ahead of main):"
  git -C "$MAIN" log --oneline "origin/main..$BRANCH" | sed 's/^/  /'
  if [ "$GO" != 1 ]; then
    [ -r /dev/tty ] || die "nothing pushed. Without a terminal, pass --yes once Wouter has said ship it."
    printf 'Push %s and open the pull request? [y/N] ' "$BRANCH"
    read -r answer < /dev/tty || answer=""
    [ "$answer" = y ] || [ "$answer" = Y ] || die "stopped; nothing was pushed."
  fi
  git -C "$MAIN" push -u origin "$BRANCH"
  ( cd "$MAIN" && env -u GH_CONFIG_DIR gh pr create --repo "$REPO" --base main --head "$BRANCH" --fill )
  exit 0 ;;
esac
RUN="$RUNS/$ID"
LANE="$(ls -d "$MAIN/.worktrees/$ID-"* 2>/dev/null | head -n 1 || true)"
[ -n "$LANE" ] || die "$ID has no lane. Run scripts/card $ID first."
BRANCH="$(git -C "$LANE" branch --show-current)"

who="$(env -u GH_CONFIG_DIR gh api user --jq .login 2>/dev/null || true)"
[ "$who" = gorillabiscuit ] || die "the GitHub CLI is logged in as '${who:-nobody}', not gorillabiscuit. Run: gh auth switch --user gorillabiscuit"
env -u GH_CONFIG_DIR gh repo view "$REPO" --json name >/dev/null 2>&1 || die "gorillabiscuit cannot see $REPO"

[ -z "$(git -C "$LANE" status --porcelain)" ] || die "$LANE has uncommitted changes; commit or clear them first."
git -C "$MAIN" fetch -q origin main
AHEAD="$(git -C "$LANE" rev-list --count origin/main..HEAD)"
BEHIND="$(git -C "$LANE" rev-list --count HEAD..origin/main)"
[ "$AHEAD" -gt 0 ] || die "$BRANCH has no commits that are not on main."

last_review="$(ls -t "$RUN"/review-*.report.md 2>/dev/null | head -n 1 || true)"
verdict="none"
[ -n "$last_review" ] && verdict="$(head -n 3 "$last_review" | sed -n 's/^Verdict: *\([a-z]*\).*/\1/p' | head -n 1)"
if [ "$verdict" = findings ] && [ "$ANYWAY" != 1 ]; then
  die "the last review reproduced a finding ($last_review). Run scripts/card $ID for a fix round, or add --anyway."
fi

TITLE="$(sed -n '1s/^# [A-Z]*-[0-9]*: //p' "$RUN/card.md" 2>/dev/null || true)"
[ -n "$TITLE" ] || TITLE="$BRANCH"
URL="$(sed -n 's/^Card: //p' "$RUN/card.md" 2>/dev/null | head -n 1 || true)"
BODY="$RUN/pr-body.md"
last_worker="$(ls -t "$RUN"/worker-*.report.md 2>/dev/null | head -n 1 || true)"
if [ -n "$last_worker" ] && grep -q '^## PR description' "$last_worker"; then
  sed -n '/^## PR description/,$p' "$last_worker" | sed '1d' > "$BODY"
else
  printf '## Summary\n\n- %s\n\n## Notes for reviewer\n\nThe worker report and the independent review are on the card.\n' "$TITLE" > "$BODY"
fi
[ -n "$URL" ] && printf '\nCard: %s\n' "$URL" >> "$BODY"

echo "About to ship $ID: $TITLE"
echo "  branch   $BRANCH ($AHEAD commit(s) ahead of main, $BEHIND behind)"
echo "  review   $verdict${last_review:+ ($last_review)}"
echo "  PR body  $BODY"
git -C "$LANE" log --oneline origin/main..HEAD | sed 's/^/  /'
[ "$BEHIND" -gt 0 ] && echo "  Note: main has moved on; the pull request may need a merge from main."
if [ "$GO" != 1 ]; then
  [ -r /dev/tty ] || die "nothing pushed. Without a terminal, pass --yes once Wouter has said ship it."
  printf 'Push %s and open the pull request? [y/N] ' "$BRANCH"
  read -r answer < /dev/tty || answer=""
  [ "$answer" = y ] || [ "$answer" = Y ] || die "stopped; nothing was pushed."
fi

git -C "$LANE" push -u origin "$BRANCH"
PR_URL="$(env -u GH_CONFIG_DIR gh pr create --repo "$REPO" --base main --head "$BRANCH" \
  --title "$TITLE ($ID)" --body-file "$BODY")"
echo "Opened $PR_URL"
printf 'Pull request opened: %s\n\nBranch `%s`, %s commit(s). Pushed with `scripts/ship`; `scripts/land` merges it once CI passes.\n' \
  "$PR_URL" "$BRANCH" "$AHEAD" > "$RUN/ship.comment.md"
"${LINEAR[@]}" comment "$ID" "$RUN/ship.comment.md" || echo "Could not comment on $ID; add the link by hand."
echo "shipped $(date -u +%FT%TZ) $PR_URL" > "$RUN/status"
